# ============================================
# 环境变量模板 / .env.template
# 复制此文件为 .env 并填入真实凭据。
# .env 已在 .gitignore 中排除，不会被提交。
# ============================================

# ----- 推送通道 -----
# 企业微信机器人 Webhook
WECOM_WEBHOOK_URL=

# 钉钉机器人 Webhook
DINGTALK_WEBHOOK_URL=

# QQ邮箱 SMTP
QQ_EMAIL_SENDER=
QQ_EMAIL_SMTP_AUTH_CODE=
QQ_EMAIL_RECEIVER=

# Bark (iOS)
BARK_KEY=

# ----- 追踪 API -----
# 51Tracking (提单/柜号直查, 200单/月免费)
FIFTYONE_TRACKING_API_KEY=

# Ship24 (提单追踪备用, 10单/月免费)
SHIP24_API_KEY=

# VesselFinder API (AIS 船位)
VESSELFINDER_API_KEY=

# ----- 运价数据源 -----
# 如需对接付费运价平台
FREIGHTOS_API_KEY=
XENETA_API_KEY=

# ----- 汇率 -----
# 中国银行外汇牌价无需 API Key，直接抓取
# 如改用其他汇率 API
EXCHANGE_RATE_API_KEY=
